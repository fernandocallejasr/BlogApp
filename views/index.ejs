<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog Home Page</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="./styles/style.css">
</head>
<body>
    <!-- HEADER -->
    <%- include("partials/header") %>

    <!-- MAIN -->
    <div class="main-container">
        <main class="px-3" id="main1">
            <h1>Your Story Starts Here</h1>
            <p class="lead">
                At Bloggy, we believe everyone has a story to tell. Whether you're an aspiring writer, a passionate storyteller, or someone who simply wants to share their experiences with the world, you've found the perfect place to do so.
            </p>
            <p class="lead">
                <a href="/app/new-blog" class="btn btn-lg btn-light fw-bold border-white bg-white">Write your first blog</a>
            </p>
        </main>

        <!-- FEATURES -->
        <div class="features-container row g-4 py-5 row-cols-1 row-cols-lg-3">
            <div class="feature col">
                <div class="feature-icon d-inline-flex align-items-center justify-content-center text-bg-primary bg-gradient fs-2 mb-3">
                    <svg class="bi" width="1em" height="1em" role="img" aria-label="Custom SVG">
                        <!-- <use xlink:href="images/loudspeaker.svg#_x32_"></use> -->
                         <image href="images/loudspeaker.png" width="1em" height="1em" style="padding: 1em;"/>
                    </svg>
                    <img >
                </div>
                <h3 class="fs-2 text-body-emphasis">Express Yourself</h3>
                <p>Share your thoughts, ideas, and insights on topics that matter to you</p>
                <a href="/app/new-blog" class="icon-link">
                    Start Blogging
                    <svg class="bi me-2" width="40" height="32" role="img" aria-label="Custom SVG">
                        <use xlink:href="images/loudspeaker.svg#_x32_"></use>
                    </svg>
                </a>
            </div>
            <div class="feature col">
                <div class="feature-icon d-inline-flex align-items-center justify-content-center text-bg-primary bg-gradient fs-2 mb-3">
                    <svg class="bi" width="1em" height="1em">
                        <image href="images/path.png"  width="1em" height="1em"/>
                    </svg>
                </div>
                <h3 class="fs-2 text-body-emphasis">Unlimited Possibilities</h3>
                <p>No topic is off-limits—whether it’s personal experiences, creative writing, travel adventures, or your latest hobby, we welcome it all.</p>
                <a href="/app/new-blog" class="icon-link">
                    Start Blogging
                    <svg class="bi"><use xlink:href="#chevron-right"></use></svg>
                </a>
            </div>
            <div class="feature col">
                <div class="feature-icon d-inline-flex align-items-center justify-content-center text-bg-primary bg-gradient fs-2 mb-3">
                    <svg class="bi" width="1em" height="1em">
                        <image href="images/leaf.png" width="1em" height="1em"/>
                    </svg>
                </div>
                <h3 class="fs-2 text-body-emphasis">Simple and Easy</h3>
                <p>Our intuitive platform makes it easy for you to write, customize, and publish your posts with just a few clicks.</p>
                <a href="/app/new-blog" class="icon-link">
                    Start Blogging
                    <svg class="bi"><use xlink:href="#chevron-right"></use></svg>
                </a>
            </div>
        </div>

    </div>

    <!-- FOOTER -->
    <%- include("partials/footer.ejs") %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>